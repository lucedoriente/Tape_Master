;
; Tape Master v2 - High-Precision Pulse Interval Generator (TX)
;
; Generates precision active-low pulses for Commodore C2N, Sharp MZ, and digital tape decks.
; Pulls 32-bit total cycle interval from TX FIFO.
; Drives pin LOW for calibrated pulse width (e.g. 20 us), then holds HIGH for remainder.
;
.program pulse_gen_tx

.wrap_target
    ; 1. Pull total interval duration in microseconds from FIFO
    pull block
    mov x, osr

    ; 2. Assert output pin LOW (pulse start)
    set pins, 0

    ; 3. Hold LOW for 20 us (20 loop iterations at 1 MHz clock)
    set y, 19
pulse_low_loop:
    jmp y-- pulse_low_loop

    ; 4. De-assert output pin HIGH (idle state)
    set pins, 1

    ; 5. Decrement X counter for remainder of interval
remainder_loop:
    jmp x-- remainder_loop
.wrap

% c-sdk {
#include "hardware/clocks.h"

static inline void pulse_gen_tx_program_init(PIO pio, uint sm, uint offset, uint pin) {
    pio_sm_config c = pulse_gen_tx_program_get_default_config(offset);
    sm_config_set_set_pins(&c, pin, 1);
    pio_gpio_init(pio, pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);
    // Clock at 1 MHz (1 cycle = 1 us)
    float div = (float)clock_get_hz(clk_sys) / 1000000.0f;
    sm_config_set_clkdiv(&c, div);
    pio_sm_init(pio, sm, offset, &c);
}
%}
