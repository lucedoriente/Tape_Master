;
; c2n_tx.pio - RP2040 PIO program for Commodore C2N signal emulation
; Pulls pulse interval duration from TX FIFO and generates standard C2N pulses.
; Active-low pulse of fixed duration (e.g. 20 us), followed by high level for remainder.
;
.program c2n_tx

.wrap_target
    ; Pull next pulse interval (in microseconds) from TX FIFO
    pull block
    mov x, osr

    ; Drive pin LOW (pulse begin)
    set pins, 0

    ; Hold pulse LOW for 20 us (assuming 1 MHz PIO clock)
    set y, 19
pulse_low_loop:
    jmp y-- pulse_low_loop

    ; Drive pin HIGH (idle state)
    set pins, 1

    ; Subtract 20 from total interval in X
    ; Remainder loop holds HIGH until interval expires
remainder_loop:
    jmp x-- test_x
    jmp done

test_x:
    jmp remainder_loop

done:
.wrap
