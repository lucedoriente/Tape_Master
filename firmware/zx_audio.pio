;
; zx_audio.pio - RP2040 PIO program for Sinclair ZX Spectrum EAR/MIC audio signal generation
; Pulls half-period tick counts from TX FIFO and toggles output pin.
; Allows cycle-accurate emulation of TZX / TAP audio blocks.
;
.program zx_audio

.wrap_target
    ; Pull half-period tick count (in 1 us units or 3.5 MHz T-states)
    pull block
    mov x, osr

    ; Toggle pin state (invert current pin level)
    mov pins, !pins

wait_half_period:
    jmp x-- wait_half_period
.wrap
