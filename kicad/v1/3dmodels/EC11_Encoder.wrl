#VRML V2.0 utf8
# Alps EC11E Vertical Rotary Encoder with Switch
# Author: Alessio Iodice for MuDIsTInf
# Exact 1:1 scale via 0.39370079 transform

Transform {
  scale 0.39370079 0.39370079 0.39370079
  children [

    # --- Lower Housing (Blue/Black Plastic) ---
    Transform {
      translation 7.50 -2.50 2.0
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.12 0.15 0.22
              specularColor 0.3 0.3 0.35
              shininess 0.3
            }
          }
          geometry Box { size 12.0 12.4 4.0 }
        }
      ]
    }

    # --- Metal Top Shell / Bracket (Zinc / Nickel plated metal) ---
    Transform {
      translation 7.50 -2.50 4.2
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.78 0.80 0.82
              specularColor 0.9 0.9 0.9
              shininess 0.7
            }
          }
          geometry Box { size 12.4 12.8 0.6 }
        }
      ]
    }

    # Left Mounting Bracket Tab (touches Pad MP at 7.5, 8.1)
    Transform {
      translation 7.50 -8.10 1.0
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.78 0.80 0.82
              specularColor 0.9 0.9 0.9
            }
          }
          geometry Box { size 2.2 0.8 7.0 }
        }
      ]
    }

    # Right Mounting Bracket Tab (touches Pad MP at 7.5, -3.1)
    Transform {
      translation 7.50 3.10 1.0
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.78 0.80 0.82
              specularColor 0.9 0.9 0.9
            }
          }
          geometry Box { size 2.2 0.8 7.0 }
        }
      ]
    }

    # --- Threaded Collar / Bushing (M7, Height: 5.0 mm) ---
    Transform {
      translation 7.50 -2.50 7.0
      rotation 1 0 0 1.5707963
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.82 0.82 0.85
              specularColor 0.95 0.95 0.95
              shininess 0.8
            }
          }
          geometry Cylinder { radius 3.4 height 5.0 }
        }
      ]
    }

    # Bushing Hex Nut Simulation
    Transform {
      translation 7.50 -2.50 5.2
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.85 0.85 0.88
              specularColor 0.95 0.95 0.95
              shininess 0.9
            }
          }
          geometry Box { size 9.0 9.0 1.2 }
        }
      ]
    }

    # --- Metallic Rotary Shaft (D-Shaft, 20mm Total Height from PCB) ---
    # Main Shaft Cylinder
    Transform {
      translation 7.50 -2.50 14.5
      rotation 1 0 0 1.5707963
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.88 0.88 0.90
              specularColor 0.98 0.98 0.98
              shininess 0.9
            }
          }
          geometry Cylinder { radius 3.0 height 11.0 }
        }
      ]
    }

    # Shaft D-Cut Flat Notch Simulation (Darker shadow face)
    Transform {
      translation 9.50 -2.50 16.0
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.70 0.70 0.72
              specularColor 0.8 0.8 0.8
            }
          }
          geometry Box { size 1.5 5.0 7.0 }
        }
      ]
    }

    # --- Pins A, C, B (Silver Metal, Left Side X=0) ---
    Transform {
      translation 0.0 0.0 -0.5
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.8 0.8 0.85 } }
          geometry Box { size 0.6 0.6 4.0 }
        }
      ]
    }
    Transform {
      translation 0.0 -2.50 -0.5
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.8 0.8 0.85 } }
          geometry Box { size 0.6 0.6 4.0 }
        }
      ]
    }
    Transform {
      translation 0.0 -5.00 -0.5
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.8 0.8 0.85 } }
          geometry Box { size 0.6 0.6 4.0 }
        }
      ]
    }

    # --- Switch Pins S1, S2 (Silver Metal, Right Side X=14.5) ---
    Transform {
      translation 14.50 0.0 -0.5
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.8 0.8 0.85 } }
          geometry Box { size 0.6 0.6 4.0 }
        }
      ]
    }
    Transform {
      translation 14.50 -5.00 -0.5
      children [
        Shape {
          appearance Appearance { material Material { diffuseColor 0.8 0.8 0.85 } }
          geometry Box { size 0.6 0.6 4.0 }
        }
      ]
    }

  ]
}
